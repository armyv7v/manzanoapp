rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rule 1: Public read access for exchange rates.
    match /config/rate {
      allow read: if true;
      // Only admins can write to config.
      allow write: if request.auth.token.admin == true;
    }

    // Rule 2: Rules for the 'orders' collection.
    match /orders/{orderId} {
      // A logged-in user can create an order if they are setting their own userId.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // A user can read their own orders. Admins can read any order.
      // This rule allows the query: .where('userId', '==', request.auth.uid)
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || request.auth.token.admin == true;

      // Only admins can update or delete orders.
      allow update, delete: if request.auth.token.admin == true;
    }

    // Rule for FCM tokens, only admins can have tokens.
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth.uid == userId && request.auth.token.admin == true;
    }

    // Rule 3: Rules for 'accounts' and 'balance_history' - only accessible by admins.
    match /accounts/{accountId} {
      allow read, write: if request.auth.token.admin == true;
    }

    match /balance_history/{historyId} {
      allow read, write: if request.auth.token.admin == true;
    }
  }
}