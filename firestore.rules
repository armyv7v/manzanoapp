rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Config collection (exchange rates, store status) is public to read
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // Orders collection
    match /orders/{orderId} {
      // Admins can do anything to any order
      allow read, write: if request.auth.token.admin == true; // read = get + list

      // Logged-in users (clients or sellers) can create orders for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Sellers can list the entire collection to build their client list for autocomplete.
      // Regular clients cannot list the whole collection.
      allow list: if request.auth.token.seller == true; 

      // Any authenticated user can read (get/list) documents where their UID matches the userId field.
      // This is the rule that allows both clients and sellers to see their own order history.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // FCM Tokens for notifications
    match /fcm_tokens/{userId} {
      // Only the owner can write their own tokens
      allow write: if request.auth != null && request.auth.uid == userId;
      // Admins can read all tokens to send notifications
      allow read: if request.auth.token.admin == true;
    }

    // Accounts for balance management
    match /accounts/{accountId} {
        allow read, write: if request.auth.token.admin == true;
    }

    // Balance history
    match /balance_history/{historyId} {
        allow read, write: if request.auth.token.admin == true;
    }

    // Seller commissions collection
    match /seller_commissions/{commissionId} {
        // Admins can read all commissions
        allow read: if request.auth.token.admin == true;
        // Sellers can read their own commissions
        allow read: if request.auth.token.seller == true && resource.data.sellerId == request.auth.uid;
        // Nobody can write directly, only the backend function
        allow write: if false;
    }

    // CLP balance history
    match /clp_balance_history/{historyId} {
        allow read, write: if request.auth.token.admin == true;
    }
  }
}