{
  "name": "remesas-app-frontend",
  "version": "1.0.0",
  "description": "Frontend assets and Tailwind CSS build for Remesas App",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "preview": "vite preview",
    "watch": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.14",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^5.4.20"
  }
}
