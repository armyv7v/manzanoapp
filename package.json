{
  "name": "remesas-app-frontend",
  "version": "1.0.0",
  "description": "Frontend assets and Tailwind CSS build for Remesas App",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "firebase-admin": "^13.6.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
