BINANCE_P2P_EMAIL=
BINANCE_P2P_PASSWORD=
BINANCE_P2P_HEADLESS=false
BINANCE_P2P_LOGIN_URL=https://accounts.binance.com/en/login
BINANCE_P2P_TARGET_URL=https://c2c.binance.com/en/trade/sell/USDT?fiat=VES
BINANCE_P2P_STORAGE_STATE_PATH=.auth/binance-p2p-storage-state.json
BINANCE_P2P_PERSISTENT_PROFILE_DIR=.auth/binance-p2p-chrome-profile
BINANCE_P2P_ARTIFACTS_DIR=artifacts
BINANCE_P2P_TIMEOUT_MS=45000
BINANCE_P2P_SLOW_MO_MS=250
BINANCE_P2P_TRACE_ON=true
BINANCE_P2P_BROWSER_EXECUTABLE_PATH=
BINANCE_P2P_CDP_URL=http://127.0.0.1:9222
BINANCE_P2P_CDP_SKIP_NAVIGATION=false
BINANCE_P2P_CAPTURE_BODY_MAX_CHARS=20000
BINANCE_P2P_PREPARE_ADVERTISER=
BINANCE_P2P_PREPARE_ROW_INDEX=0
BINANCE_P2P_PREPARE_AMOUNT=
BINANCE_P2P_PREPARE_AMOUNT_MODE=fiat
BINANCE_P2P_PREPARE_OPEN_PANEL_WAIT_MS=2500
BINANCE_P2P_PREPARE_MAX_ADS=10
