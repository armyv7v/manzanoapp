{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": [
    "src/**/*.ts",
    "*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}