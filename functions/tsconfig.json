{
    "include": ["index.js"],
    "exclude":  [
                    "node_modules",
                    "lib",
                    "scr"
                ],
    "compilerOptions":  {
                            "allowSyntheticDefaultImports":  true,
                            "allowJs": true,
                            "outDir":  "lib",
                            "lib":  [
                                        "ES2022"
                                    ],
                            "types":  [

                                      ],
                            "typeRoots":  [
                                              "./node_modules/@types"
                                          ],
                            "strict":  true,
                            "target":  "ES2022",
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "module":  "commonjs",
                            "noEmit": true
                        }
}
