[debug] [2025-09-23T13:56:57.250Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/manzanoapp-2f775/rulesets {"name":"projects/manzanoapp-2f775/rulesets/4a2f492c-d6b6-4dee-a83b-21c8ad695d03","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Default deny all reads and writes\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Config collection (exchange rates, store status) is public to read\n    match /config/{docId} {\n      allow read: if true;\n      allow write: if request.auth.token.admin == true;\n    }\n\n    // Orders collection\n    match /orders/{orderId} {\n      // Admins can do anything to any order\n      allow read, write: if request.auth.token.admin == true;\n\n      // Logged-in users (clients or sellers) can create orders for themselves\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n\n      // Logged-in users can read their own orders\n      allow read: if request.auth != null && resource.data.userId == request.auth.uid;\n    }\n\n    // FCM Tokens for notifications\n    match /fcm_tokens/{userId} {\n      // Only the owner can write their own tokens\n      allow write: if request.auth != null && request.auth.uid == userId;\n      // Admins can read all tokens to send notifications\n      allow read: if request.auth.token.admin == true;\n    }\n\n    // Accounts for balance management\n    match /accounts/{accountId} {\n        allow read, write: if request.auth.token.admin == true;\n    }\n\n    // Balance history\n    match /balance_history/{historyId} {\n        allow read, write: if request.auth.token.admin == true;\n    }\n\n    // Seller commissions collection\n    match /seller_commissions/{commissionId} {\n        // Admins can read all commissions\n        allow read: if request.auth.token.admin == true;\n        // Sellers can read their own commissions\n        allow read: if request.auth.token.seller == true && resource.data.sellerId == request.auth.uid;\n        // Nobody can write directly, only the backend function\n        allow write: if false;\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2025-09-23T13:56:58.069007Z","metadata":{"services":["cloud.firestore"]}}
