PORT=3005
VPS_AUTH_TOKEN=replace_me
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com

# Binance P2P worker
BINANCE_P2P_WORKER_POLL_MS=5000
BINANCE_P2P_ACTION_TIMEOUT_MS=180000
BINANCE_P2P_WORKER_NAME=frankfurt-vps
BINANCE_P2P_REPO_ROOT=/opt/manzanoapp
# Use ONE of the following Firebase credential options:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/manzanoapp/serviceAccountKey.json
