rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Proofs uploaded by admins for paid orders
    match /proofs/{orderId}/{allPaths=**} {
      allow read: if true;
      // Allow any authenticated user to write
      // Security is enforced at the application level (only admins can access payment flow)
      allow write: if request.auth != null;
    }

    // Proofs uploaded by clients/sellers
    match /client_proofs/{orderId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}